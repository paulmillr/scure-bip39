{
  "name": "@notus/scure-bip39",
  "version": "2.2.0",
  "description": "Notus fork of @scure/bip39: a secure, audited & minimal implementation of BIP39 mnemonic phrases",
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "6.0.2"
  },
  "author": "Paul Miller (https://paulmillr.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notuslabs/scure-bip39.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write 'src/**/*.ts' 'test/*.test.ts' 'test/scripts/*.js'",
    "test": "node --experimental-strip-types --no-warnings test/index.ts"
  },
  "keywords": [
    "bip39",
    "mnemonic",
    "phrase",
    "code",
    "bip0039",
    "bip-39",
    "wordlist",
    "scure",
    "noble",
    "bitcoin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/notuslabs/scure-bip39"
}
